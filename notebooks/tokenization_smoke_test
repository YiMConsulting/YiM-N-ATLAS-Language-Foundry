name":"stdout","text":["\n","Tokenizer loaded successfully.\n","Model: NCAIR1/N-ATLaS\n","Tokenizer class: TokenizersBackend\n","Vocabulary size: 128256\n","PAD token: '<|eot_id|>'\n","PAD token ID: 128009\n","EOS token: '<|eot_id|>'\n","EOS token ID: 128009\n","Chat template available: True\n"]}]},{"cell_type":"code","source":["# Run a diagnostic check preprocessing small validation subsets from local datasets.\n","import json\n","import random\n","import sys\n","from collections import Counter\n","from pathlib import Path\n","import numpy as np\n","\n","REPO_DIR = Path(\"/content/drive/MyDrive/foundry/YiM-N-ATLAS-Language-Foundry\")\n","if str(REPO_DIR) not in sys.path:\n","    sys.path.insert(0, str(REPO_DIR))\n","\n","from foundry.datasets.record import DatasetRecord\n","from foundry.training.preprocessing import NAtlasPreprocessor\n","\n","DATA_DIR = Path(\"/content/drive/MyDrive/foundry/tiv-mt560-v1\")\n","assert \"tokenizer\" in globals(), \"Load the actual N-ATLaS tokenizer before running this cell.\"\n","\n","SAMPLE_SIZES = {\"train\": 100, \"validation\": 30, \"test\": 30}\n","SEED = 42\n","MAX_LENGTH = 512\n","\n","preprocessor = NAtlasPreprocessor(tokenizer=tokenizer, max_length=MAX_LENGTH)\n","\n","def deterministic_reservoir_sample(path, sample_size, seed):\n","    rng = random.Random(seed)\n","    sample = []\n","    with path.open(\"r\", encoding=\"utf-8\") as file:\n","        for index, line in enumerate(file):\n","            if not line.strip(): continue\n","            record = json.loads(line)\n","            if len(sample) < sample_size:\n","                sample.append(record)\n","            else:\n","                replacement_index = rng.randrange(index + 1)\n","                if replacement_index < sample_size:\n","                    sample[replacement_index] = record\n","    return sample\n","\n","def sequence_length(record):\n","    messages = [\n","        {\"role\": \"user\", \"content\": record.input},\n","        {\"role\": \"assistant\", \"content\": record.target},\n","    ]\n","    encoded = tokenizer.apply_chat_template(messages, tokenize=True, add_generation_prompt=False, return_dict=True)\n","    return len(encoded[\"input_ids\"])\n","\n","all_results = {}\n","for split, sample_size in SAMPLE_SIZES.items():\n","    path = DATA_DIR / f\"{split}.jsonl\"\n","    assert path.is_file(), f\"Missing split file: {path}\"\n","    sample = deterministic_reservoir_sample(path, sample_size=sample_size, seed=SEED)\n","    lengths = []\n","    counts = Counter()\n","    failures = []\n","    for raw_record in sample:\n","        record_id = raw_record.get(\"id\", \"<unknown>\")\n","        try:\n","            record = DatasetRecord.model_validate(raw_record)\n","            length = sequence_length(record)\n","            lengths.append(length)\n","            try:\n","                preprocessor.preprocess(record)\n","                counts[\"success\"] += 1\n","            except Exception as exc:\n","                reason = f\"{type(exc).__name__}: {exc}\"\n","                if isinstance(exc, ValueError) and \"exceeds configured max_length\" in str(exc):\n","                    counts[\"overlength\"] += 1\n","                    category = \"overlength\"\n","                else:\n","                    counts[\"other_failure\"] += 1\n","                    category = \"other_failure\"\n","                failures.append({\"split\": split, \"record_id\": record.id, \"category\": category, \"sequence_length\": length, \"reason\": reason})\n","        except Exception as exc:\n","            counts[\"other_failure\"] += 1\n","            failures.append({\"split\": split, \"record_id\": record_id, \"category\": \"other_failure\", \"sequence_length\": None, \"reason\": f\"{type(exc).__name__}: {exc}\"})\n","    print(f\"\\n{'=' * 60}\\nSPLIT: {split}\\n{'=' * 60}\\nSample size: {len(sample)}\\nSuccessful: {counts['success']}\\nOverlength: {counts['overlength']}\\nOther failures: {counts['other_failure']}\")\n","    if lengths:\n","        percentiles = np.percentile(lengths, [50, 90, 95, 99])\n","        print(f\"\\nFull-sequence token lengths:\\nMinimum: {min(lengths)}\\nP50: {round(float(percentiles[0]), 2)}\\nP90: {round(float(percentiles[1]), 2)}\\nP95: {round(float(percentiles[2]), 2)}\\nP99: {round(float(percentiles[3]), 2)}\\nMaximum: {max(lengths)}\")\n","    all_results[split] = {\"sample_size\": len(sample), \"success\": counts[\"success\"], \"overlength\": counts[\"overlength\"], \"other_failure\": counts[\"other_failure\"], \"lengths_measured\": len(lengths), \"failures\": failures}"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"A2BHNa30t2qp","executionInfo":{"status":"ok","timestamp":1791738218212,"user_tz":-60,"elapsed":7803,"user":{"displayName":"Abah Unekwuojo","userId":"06086286152271318487"}},"outputId":"8d04c76c-bf01-4c42-c32a-b0f388194944"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","============================================================\n","SPLIT: train\n","============================================================\n","Sample size: 100\n","Successful: 100\n","Overlength: 0\n","Other failures: 0\n","\n","Full-sequence token lengths:\n","Minimum: 48\n","P50: 90.5\n","P90: 132.3\n","P95: 150.4\n","P99: 168.13\n","Maximum: 181\n","\n","============================================================\n","SPLIT: validation\n","============================================================\n","Sample size: 30\n","Successful: 30\n","Overlength: 0\n","Other failures: 0\n","\n","Full-sequence token lengths:\n","Minimum: 60\n","P50: 102.5\n","P90: 132.0\n","P95: 144.65\n","P99: 176.3\n","Maximum: 185\n","\n","============================================================\n","SPLIT: test\n","============================================================\n","Sample size: 30\n","Successful: 30\n","Overlength: 0\n","Other failures: 0\n","\n","Full-sequence token lengths:\n","Minimum: 47\n","P50: 91.0\n","P90: 147.0\n","P95: 165.9\n","P99: 178.26\n","Maximum: 180\n"]}]},{"cell_type":"code","source":["# Audit full token lengths across entire datasets to determine maximum sequence distribution.\n","import json\n","from pathlib import Path\n","from collections import Counter\n","import numpy as np\n","\n","DATA_DIR = Path(\"/content/drive/MyDrive/foundry/tiv-mt560-v1\")\n","REPORT_PATH = Path(\"/content/drive/MyDrive/foundry/tiv_token_length_audit.json\")\n","MAX_LENGTH = 512\n","\n","audit = {}\n","for split in (\"train\", \"validation\", \"test\"):\n","    path = DATA_DIR / f\"{split}.jsonl\"\n","    count = 0\n","    lengths = []\n","    overlength = []\n","    failures = Counter()\n","    failure_examples = []\n","    with path.open(\"r\", encoding=\"utf-8\") as file:\n","        for line_number, line in enumerate(file, start=1):\n","            if not line.strip(): continue\n","            count += 1\n","            try:\n","                record = json.loads(line)\n","                messages = [\n","                    {\"role\": \"user\", \"content\": record[\"input\"]},\n","                    {\"role\": \"assistant\", \"content\": record[\"target\"]},\n","                ]\n","                encoded = tokenizer.apply_chat_template(messages, tokenize=True, add_generation_prompt=False, return_dict=True)\n","                length = len(encoded[\"input_ids\"])\n","                lengths.append(length)\n","                if length > MAX_LENGTH:\n","                    overlength.append({\"id\": record.get(\"id\", \"<unknown>\"), \"line_number\": line_number, \"length\": length})\n","            except Exception as exc:\n","                failures[type(exc).__name__] += 1\n","                if len(failure_examples) < 20:\n","                    failure_examples.append({\"line_number\": line_number, \"record_id\": record.get(\"id\", \"<unknown>\") if \"record\" in locals() else \"<unknown>\", \"error\": f\"{type(exc).__name__}: {exc}\"})\n","    percentiles = {}\n","    if lengths:\n","        values = np.percentile(lengths, [50, 90, 95, 99])\n","        percentiles = {\"p50\": float(values[0]), \"p90\": float(values[1]), \"p95\": float(values[2]), \"p99\": float(values[3])}\n","    audit[split] = {\"records_scanned\": count, \"lengths_measured\": len(lengths), \"max_length_limit\": MAX_LENGTH, \"overlength_count\": len(overlength), \"other_failure_count\": sum(failures.values()), \"failure_types\": dict(failures), \"min_tokens\": min(lengths) if lengths else None, \"max_tokens\": max(lengths) if lengths else None, \"percentiles\": percentiles, \"overlength_examples\": overlength[:20], \"failure_examples\": failure_examples}\n","\n","REPORT_PATH.write_text(json.dumps(audit, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n","print(\"\\nAudit report saved to:\", REPORT_PATH)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"alSzRKiHuY8K","executionInfo":{"status":"ok","timestamp":1791738351823,"user_tz":-60,"elapsed":133583,"user":{"displayName":"Abah Unekwuojo","userId":"06086286152271318487"}},"outputId":"4feec060-6551-405f-d247-a4544d3bbf72"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Audit report saved to: /content/drive/MyDrive/foundry/tiv_token_length_audit.json\n"]}]},{"cell_type":"code","source":["# Validate integration of the data preprocessing, collation, and PyTorch Dataloaders on a sample scale.\n","import json\n","import random\n","import sys\n","from pathlib import Path\n","import torch\n","from torch.utils.data import DataLoader\n","\n","REPO_DIR = Path(\"/content/drive/MyDrive/foundry/YiM-N-ATLAS-Language-Foundry\")\n","if str(REPO_DIR) not in sys.path:\n","    sys.path.insert(0, str(REPO_DIR))\n","\n","from foundry.datasets.record import DatasetRecord\n","from foundry.training.preprocessing import IGNORE_INDEX, NAtlasPreprocessor\n","from foundry.training.collator import NAtlasDataCollator\n","\n","DATA_DIR = Path(\"/content/drive/MyDrive/foundry/tiv-mt560-v1\")\n","SEED = 42\n","MAX_LENGTH = 512\n","SAMPLE_SIZES = {\"train\": 16, \"validation\": 4}\n","\n","def sample_records(path, count, seed):\n","    rng = random.Random(seed)\n","    selected = []\n","    with path.open(encoding=\"utf-8\") as f:\n","        for index, line in enumerate(f):\n","            if not line.strip(): continue\n","            record = json.loads(line)\n","            if len(selected) < count:\n","                selected.append(record)\n","            else:\n","                j = rng.randrange(index + 1)\n","                if j < count: selected[j] = record\n","    return selected\n","\n","preprocessor = NAtlasPreprocessor(tokenizer=tokenizer, max_length=MAX_LENGTH)\n","collator = NAtlasDataCollator(tokenizer=tokenizer)\n","processed = {}\n","\n","for split, count in SAMPLE_SIZES.items():\n","    raw_records = sample_records(DATA_DIR / f\"{split}.jsonl\", count, SEED)\n","    examples = []\n","    for raw in raw_records:\n","        record = DatasetRecord.model_validate(raw)\n","        assert record.language_code == \"tiv\"\n","        examples.append(preprocessor.preprocess(record))\n","    processed[split] = examples\n","\n","train_loader = DataLoader(processed[\"train\"], batch_size=2, shuffle=False, collate_fn=collator)\n","validation_loader = DataLoader(processed[\"validation\"], batch_size=2, shuffle=False, collate_fn=collator)\n","\n","for name, loader in ((\"train\", train_loader), (\"validation\", validation_loader)):\n","    batch = next(iter(loader))\n","    print(f\"\\n{name.upper()} BATCH\")\n","    for key, tensor in batch.items():\n","        print(f\"{key}: shape={tuple(tensor.shape)}, dtype={tensor.dtype}\")\n","    supervised_tokens = int((batch[\"labels\"] != IGNORE_INDEX).sum().item())\n","    print(\"Supervised tokens:\", supervised_tokens)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0xFaxdZ9ujvv","executionInfo":{"status":"ok","timestamp":1791738352753,"user