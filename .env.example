# ==============================================================================
# N-ATLAS LANGUAGE FOUNDRY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Hugging Face Access (Required for gated NCAIR1/N-ATLaS model)
HF_TOKEN=your_huggingface_access_token_here

# Base Model Identifier
BASE_MODEL_NAME=NCAIR1/N-ATLaS
DEVICE_MAP=auto

# Server & API Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database Settings
DATABASE_URL=sqlite:///./foundry.db

# Experiments Directory
EXPERIMENTS_DIR=./experiments
OUTPUTS_DIR=./outputs

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000

# Runtime Inference Demo Config (Experimental English-to-Tiv Kaggle Gradio Share URL)
# Example: https://490f55186b25f3a26c.gradio.live
TIV_GRADIO_URL=
